---
---
<article id="{{ entry.key }}" class="publication-entry">
  <div class="title">{{ entry.title }}</div>
  <div class="author">
    {% for author in entry.author_array %}
      {% assign is_self = false %}
      {% if author.last == 'Islam' and author.first contains 'Mohammed' %}
        {% assign is_self = true %}
      {% endif %}
      {% unless forloop.first -%}
        {%- if forloop.last %} and {% else %}, {% endif -%}
      {%- endunless %}
      {% if is_self -%}
        <strong>
          {{- author.first }}
          {{ author.last -}}
        </strong>
      {%- else -%}
        {{- author.first }}
        {{ author.last -}}
      {%- endif %}
    {% endfor %}
  </div>
  <div class="periodical">
    {% if entry.abbr -%}
      <span class="work-meta">{{ entry.abbr }}</span> ·
    {% endif %}
    {% if entry.type == 'article' -%}
      <em>{{ entry.journal }}</em>
    {%- elsif entry.type == 'inproceedings' -%}
      <em>{{ entry.booktitle }}</em>
    {%- elsif entry.type == 'phdthesis' or entry.type == 'mastersthesis' -%}
      <em>{{ entry.school }}</em>
    {%- endif -%}
    {%- if entry.year %}, {{ entry.year }}{% endif %}
  </div>
  <div class="links">
    {% if entry.html -%}
      <a href="{{ entry.html }}" class="btn btn-sm z-depth-0">Paper</a>
    {%- endif %}
    {% if entry.arxiv -%}
      <a href="https://arxiv.org/abs/{{ entry.arxiv }}" class="btn btn-sm z-depth-0">arXiv</a>
    {%- endif %}
    {% if entry.pdf -%}
      <a href="{{ entry.pdf }}" class="btn btn-sm z-depth-0">PDF</a>
    {%- endif %}
    {% if entry.code -%}
      <a href="{{ entry.code }}" class="btn btn-sm z-depth-0">Code</a>
    {%- endif %}
    {% if entry.website -%}
      <a href="{{ entry.website }}" class="btn btn-sm z-depth-0">Project</a>
    {%- endif %}
  </div>
</article>
